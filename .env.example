# ========== DATABASE CONFIGURATION ==========
# Default: rotondwa
# DB_ROOT_PASSWORD=rotondwa

# Default: transactions
# DB_NAME=transactions

# Default: app_user
# DB_USER=app_user

# Default: app_password
# DB_PASSWORD=app_password

# Default: 3306
# DB_PORT=3306

# ========== BACKEND CONFIGURATION ==========
# Default: 8080
# BACKEND_PORT=8080

# Default: update (options: validate, update, create, create-drop, none)
# JPA_DDL_AUTO=update

# Default: false
# JPA_SHOW_SQL=false

# ========== FRONTEND CONFIGURATION ==========
# Default: 3000
# FRONTEND_PORT=3000

# Default: http://localhost:8080
# VITE_API_BASE_URL=http://localhost:8080

# ========== JAVA OPTIONS ==========
# Default: -Xmx512m -Xms256m
# JAVA_OPTS=-Xmx512m -Xms256m

# ========== LOGGING ==========
# Default: false
# SPRING_JPA_SHOW_SQL=false

# Default: INFO
# LOGGING_LEVEL_ROOT=INFO

# Default: DEBUG
# LOGGING_LEVEL_TRANSACTIONS_DISPUTE_PORTAL=DEBUG

